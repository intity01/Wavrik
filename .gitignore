# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Pytest & test cache / temp folders
.pytest_cache/
.ruff_cache/
.pytest-temp*/
.pytest_tmp*/
.tmp-pytest*/
**/.pytest_cache/
**/.ruff_cache/
**/.pytest-temp*/
**/.pytest_tmp*/
**/.tmp-pytest*/
.coverage
.coverage.*
*.cover
nosetests.xml
coverage.xml

# Virtual environments
.venv/
.build-venv/
.qa-venv/
venv/
env/
ENV/
**/.venv/
**/.build-venv/
**/.qa-venv/

# Build artifacts & distribution
build/
dist/
*.egg-info/
*.egg
*.manifest

# External heavy binaries
# Place ffmpeg.exe at repo root for local running and PyInstaller packaging,
# but do not commit to Git to prevent repo bloat (>50MB GitHub warning, 100MB limit).
ffmpeg.exe

# User data & application state files
settings.json
history.json
*.log

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
